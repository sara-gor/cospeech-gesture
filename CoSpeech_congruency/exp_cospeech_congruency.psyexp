    <LoopTerminator name="twoThirdsLoop"/>
    <LoopTerminator name="trialsLoop"/>
    <LoopTerminator name="blockLoop"/>
    <Routine name="goodbyeScreen"/>
  </Flow>
</PsychoPy2experiment>
